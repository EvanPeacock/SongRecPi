# Rendered by install.sh: @USER@, @HOME@, @APP_DIR@ and @SONGREC_PATH@ are replaced.
[Unit]
Description=SongRecPi song recognition + kiosk web app
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
SupplementaryGroups=audio
WorkingDirectory=@HOME@
ExecStart=/usr/bin/python3 @APP_DIR@/app.py
Environment=PYTHONUNBUFFERED=1
Environment=SONGREC_PATH=@SONGREC_PATH@
# Optional overrides (HOST, PORT, IDLE_TIMEOUT, ...) go in this file.
EnvironmentFile=-/etc/default/songrecpi
# Python handles SIGINT cleanly and stops songrec; KillMode signals the whole cgroup.
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=10
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
