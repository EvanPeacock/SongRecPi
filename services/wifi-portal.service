# Rendered by install.sh: @APP_DIR@ is replaced.
[Unit]
Description=SongRecPi WiFi setup hotspot (when no known network is found at boot)
After=NetworkManager.service systemd-tmpfiles-setup.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=@APP_DIR@/wifi-portal-start.sh
Restart=no

[Install]
WantedBy=multi-user.target
